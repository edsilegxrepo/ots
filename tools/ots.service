[Unit]
Description=OTS One-Time Secrets Service
Documentation=https://github.com/edsilegxrepo/ots
After=syslog.target network-online.target redis.service
Wants=network-online.target redis.service
StartLimitIntervalSec=500
StartLimitBurst=5

[Service]
Type=simple
User=websvc
Group=apps

# Supports both RHEL/CentOS (/etc/sysconfig/ots) and Debian/Ubuntu (/etc/default/ots)
EnvironmentFile=-/etc/sysconfig/ots
EnvironmentFile=-/etc/default/ots
EnvironmentFile=-/etc/ots/ots.env

ExecStart=/usr/sbin/ots --listen ${OTS_LISTENER} --log-level ${OTS_LOG_LEVEL} --storage-type ${OTS_STORAGE} --customize ${OTS_CONFIG}
TimeoutSec=300
Restart=always
RestartSec=10

# Security & Isolation Hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

